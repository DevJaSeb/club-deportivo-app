<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inscribirPersona"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--        Flecha volver y Título      -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:layout_marginTop="30dp"
            android:padding="20dp">

            <!--        Flecha Volver      -->
            <ImageView
                android:id="@+id/btn_volver"
                android:layout_width="140dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:srcCompat="@drawable/baseline_arrow_back_24"
                android:contentDescription="@string/flecha_de_regreso"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/roboto"
                android:gravity="center_vertical"
                android:text="@string/pagar_cuota"
                android:textSize="25sp" />
        </LinearLayout>

        <!--        Formulario      -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="15dp">

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center">

                <!--        SearchBar Usuarios Activos      -->
                <com.google.android.material.search.SearchBar
                    android:id="@+id/sb_usuarios"
                    android:layout_width="350dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_usuarios"
                    android:pointerIcon="none"
                    app:backgroundTint="@color/material_dynamic_tertiary90"
                    app:menu="@menu/search_bar_menu"
                    app:navigationIcon="@drawable/baseline_format_list_bulleted_24" />

                <!--        Resultados Usuarios Activos      -->
                <com.google.android.material.search.SearchView
                    android:id="@+id/sv_usuarios"
                    android:layout_width="350dp"
                    android:layout_height="wrap_content"
                    app:backgroundTint="@color/material_dynamic_tertiary90"
                    app:layout_anchor="@id/sb_usuarios"
                    app:layout_anchorGravity="bottom"
                    android:background="@drawable/curved_border">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_usuarios"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </com.google.android.material.search.SearchView>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
            <!--        Barra Separadora      -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:dividerThickness="1dp"
                app:dividerColor="#D3D3D3"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="10dp"/>

            <!--        Input: Fecha de Pago      -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="350dp"
                android:id="@+id/til_fechaDePago"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:hint="@string/fecha_de_pago"
                app:placeholderText="dd/mm/yyyy"
                app:startIconDrawable="@drawable/baseline_calendar_month_24"
                android:textColorHint="@color/text_label"
                app:hintTextColor="@color/primary_purple">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_fechaDePago"
                    android:layout_width="350dp"
                    android:layout_height="wrap_content"
                    android:autofillHints="Fecha de Pago"
                    android:inputType="date"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--        Input: Monto      -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:id="@+id/til_monto"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:hint="@string/ingresar_monto"
                app:startIconDrawable="@drawable/baseline_attach_money_24"
                app:placeholderText="Monto"
                android:textColorHint="@color/text_label"
                app:hintTextColor="@color/primary_purple">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_monto"
                    android:layout_width="350dp"
                    android:layout_height="wrap_content"
                    android:autofillHints="monto"
                    android:inputType="number"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--        Menú Vertical: Forma de Pago      -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_forma_de_pago"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:hint="@string/forma_de_pago"
                app:placeholderText="@string/forma_de_pago"
                app:startIconDrawable="@drawable/baseline_payments_24"
                android:textColorHint="@color/text_label"
                app:hintTextColor="@color/primary_purple">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/et_forma_de_pago"
                    android:layout_width="350dp"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="16sp"
                    tools:ignore="LabelFor,SpeakableTextPresentCheck"/>
            </com.google.android.material.textfield.TextInputLayout>


            <!--        Menú Vertical: Selector de Actividades      -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_actividades"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:hint="@string/selector_de_actividades"
                app:startIconDrawable="@drawable/baseline_sports_martial_arts_24"
                android:textColorHint="@color/text_label"
                app:hintTextColor="@color/primary_purple">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/et_actividades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="16sp"
                    tools:ignore="LabelFor,SpeakableTextPresentCheck"/>
            </com.google.android.material.textfield.TextInputLayout>


        </LinearLayout>

        <!--        Botón de Registrar Pago      -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_registrar_pago"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_registrar_pago"
            android:paddingVertical="15dp"
            android:layout_gravity="center"
            android:layout_marginTop="40dp" />

    </LinearLayout>
</ScrollView>